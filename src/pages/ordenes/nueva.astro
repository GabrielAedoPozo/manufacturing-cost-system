---
import Layout from '../../layouts/layout.astro';
import Hero from '../../components/hero.astro';
import NewOrder from '../../components/new-order';
import { ROUTES } from '../../config/routes';
import { lineSettings, orders, products, rawMaterials, recipes } from '../../data/mock';

// Las órdenes nuevas siguen la numeración de las existentes ("OF-0041" → 42).
const nextOrderNumber = Math.max(...orders.map((order) => Number(order.id.slice(3)))) + 1;
---

<Layout title={ROUTES.newOrder.label}>
  <Hero
    title={ROUTES.newOrder.label}
    subtitle="Elige un producto y la cantidad: el costo se calcula con su receta y los datos base de su línea."
  />
  <div class="mt-6">
    <NewOrder
      client:load
      products={products}
      recipes={recipes}
      catalog={{ rawMaterials, lineSettings }}
      nextOrderNumber={nextOrderNumber}
    />
  </div>
</Layout>
